{
  "name": "water-tanker-dispatch-system",
  "private": true,
  "version": "0.0.0",
  "description": "Runs all servers (FastAPI backend + all 3 role UIs) together for local demo/dev.",
  "scripts": {
    "dev": "concurrently -n backend,dispatcher,volunteer,driver -c blue,green,yellow,magenta \"npm:dev:backend\" \"npm:dev:dispatcher\" \"npm:dev:volunteer\" \"npm:dev:driver\"",
    "dev:backend": "python -m uvicorn main:app --port 8000 --app-dir phase3_repair/backend",
    "dev:dispatcher": "npm run dev --prefix frontend",
    "dev:volunteer": "npm run dev --prefix phase4_volunteer",
    "dev:driver": "npm run dev --prefix phase4_driver"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
